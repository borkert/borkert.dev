# OpenRouter API Key (sk-or-v1-...)
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# Base URL for OpenAI-compatible clients
OPENAI_API_BASE=https://openrouter.ai/api/v1
